<mxfile host="app.diagrams.net">
  <diagram name="flow">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" page="1" pageWidth="1080" pageHeight="1080">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s" value="进入列表页 / 从编辑页返回" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="320" height="42" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="onStart() → startAsyncNotesListQuery()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#7F7F7F;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="380" y="132" width="320" height="48" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="mCurrentFolderId
== ID_ROOT_FOLDER ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#BF9000;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="370" y="200" width="340" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="selection = ROOT_FOLDER_SELECTION
排除 TYPE_SYSTEM；通话记录文件夹
仅在 NOTES_COUNT > 0 时出现" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#7F7F7F;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="selection = NORMAL_SELECTION
PARENT_ID = mCurrentFolderId
子文件夹内条目全部列出" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#7F7F7F;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="680" y="320" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="AsyncQueryHandler.startQuery()
