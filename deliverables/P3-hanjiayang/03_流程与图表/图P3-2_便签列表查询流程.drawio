排序：TYPE DESC, MODIFIED_DATE DESC" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#548235;fontSize=12;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="445" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="后台线程经 NotesProvider 查询 SQLite" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#7F7F7F;fontSize=13;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="300" y="550" width="480" height="50" as="geometry" />
